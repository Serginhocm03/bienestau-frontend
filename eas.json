{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.11.0"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "node": "22.11.0",
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true",
        "EXPO_PUBLIC_SERVER": "https://bienestau-backend-90lq.onrender.com",
        "EXPO_PUBLIC_TOKEN_KEY": "jwt"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "node": "22.11.0",
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true",
        "EXPO_PUBLIC_SERVER": "https://bienestau-backend-90lq.onrender.com",
        "EXPO_PUBLIC_TOKEN_KEY": "jwt"
      }
    }
  },
  "submit": {
    "production": {}
  }
}